# Kopyala: cp .env.example .env  — sonra değerleri doldur. .env asla commit edilmez.

# Django
SECRET_KEY=buraya-uzun-rastgele-bir-anahtar
DEBUG=False
ALLOWED_HOSTS=sevgispor.up.railway.app,localhost
CSRF_TRUSTED_ORIGINS=https://sevgispor.up.railway.app

# HTTPS arkasında çalışırken True yap
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# PostgreSQL (docker compose bu üç değeri db servisine de verir; Railway kendi DATABASE_URL değerini verir)
# Not: Eski docker-compose.yml veritabanı ve kullanıcı adı olarak "karabaglar" kullanıyordu.
# Sunucuda mevcut bir veritabanı varsa bu iki değeri ona göre bırak.
POSTGRES_DB=sevgispor
POSTGRES_USER=sevgispor
POSTGRES_PASSWORD=guclu-bir-sifre
DATABASE_URL=postgres://sevgispor:guclu-bir-sifre@db:5432/sevgispor

# Cloudinary (medya dosyaları)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# setup.sh ile ilk yönetici hesabı (isteğe bağlı)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
